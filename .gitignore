# ── Secrets — never commit ────────────────────────────────────────────────────
.env
push_tokens.json
# GCP runtime service-account key (build-day handoff)
omnidba-sa.json

# ── Runtime / process files ───────────────────────────────────────────────────
*.pid
nohup.out
logs/

# ── Python ────────────────────────────────────────────────────────────────────
.venv/
# v3 GCP worktree virtualenv (isolated from v1) + pip install transcript
.venv-gcp/
logs_pipinstall.txt
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
dist/
build/

# ── ChromaDB vector store ─────────────────────────────────────────────────────
# Large binary files — regenerate on target machine with: startup.sh train
chroma_db/
# v3 RAG stores (Oracle + Postgres)
chroma_db_gcp/
chroma_db_pg/

# ── SSL certificates ──────────────────────────────────────────────────────────
*.key
*.crt

# ── User data ─────────────────────────────────────────────────────────────────
# Contains real email addresses + bcrypt hashes — use users.json.example as template
users.json

# ── Mobile / Node ─────────────────────────────────────────────────────────────
mobile/node_modules/
mobile/.expo/
mobile/.expo-shared/
mobile/dist/
mobile/.cache/
mobile/web-build/

# ── OS / editor ───────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/
.pgpw
sa-key.json
