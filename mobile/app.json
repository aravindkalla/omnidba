{
  "expo": {
    "name": "OmniDBA",
    "slug": "omnidba",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "oracledba",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0D1117"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.cgi.omnidba",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Use Face ID to securely unlock OmniDBA."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0D1117"
      },
      "package": "com.cgi.omnidba",
      "usesCleartextTraffic": true
    },
    "plugins": [
      "expo-router",
      "expo-local-authentication",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#1565C0",
          "sounds": []
        }
      ]
    ],
    "updates": {
      "enabled": false
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "http://34.14.171.170:8000"
    }
  }
}
